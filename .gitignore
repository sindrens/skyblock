.DS_Store

# Local test server (./gradlew runServer)
run/

# Server runtime: only configs and scripts are tracked. Jars, worlds, logs, caches, player data and keys are not.
server/*/
!server/config/
!server/plugins/
!server/scripts/
server/*.jar
server/*.json
server/eula.txt
server/wepif.yml
server/.console_history
server/session.lock
server/.vps-target
server/plugins/**
!server/plugins/*/
!server/plugins/Geyser-Spigot/config.yml
!server/plugins/floodgate/config.yml
!server/plugins/LuckPerms/config.yml
!server/plugins/GrimAC/*.yml
!server/plugins/FastAsyncWorldEdit/config.yml
!server/plugins/FastAsyncWorldEdit/worldedit-config.yml
!server/plugins/ViaVersion/config.yml
!server/plugins/ViaBackwards/config.yml
*.log
*.db
*.sqlite
*.pem

# Secrets
.env
**/secrets.yml
